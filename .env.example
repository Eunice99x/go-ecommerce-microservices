# Application
APP_ENV=development
SERVER_PORT=3000
GRPC_PORT=50051
GRPC_HOST=localhost

# gRPC mutual TLS - all three or none (none = plaintext, local go run only)
# generate dev certs with: make certs
GRPC_TLS_CA=
GRPC_TLS_CERT=
GRPC_TLS_KEY=

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecomm
DB_SSLMODE=disable

# Auth - must be at least 32 characters
SECRET_KEY=

# Notifier - leave SMTP_HOST empty to log emails instead of sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
